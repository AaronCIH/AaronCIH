---
import { Image } from 'astro:assets';
import type { SiteImage } from '../data/media';
interface Props { image: SiteImage; variant?: 'card' | 'stage' | 'index' }
const { image, variant = 'stage' } = Astro.props;
const maxWidth = variant === 'index' ? 480 : 1280;
const width = Math.min(image.src.width, maxWidth);
const widths = [...new Set([240, 480, 800, width].filter((value) => value <= width))].sort((a, b) => a - b);
const sizes = variant === 'index' ? '(max-width: 700px) 88px, 160px' : variant === 'card' ? '(max-width: 700px) 90vw, 360px' : '(max-width: 959px) 90vw, 560px';
---
<Image src={image.src} alt={image.alt} class:list={['project-image', `project-image-${variant}`]} width={width} widths={widths} sizes={sizes} format="webp" quality={90} loading="lazy" decoding="async" />
