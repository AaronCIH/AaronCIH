---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { experience, education } from '../data/profile';
import { sitePath } from '../utils/paths';
---
<Layout title="Experience" active="Experience">
  <section class="page-heading container"><p class="eyebrow">RESEARCH / INDUSTRY / LEARNING</p><div class="page-heading-row"><h1>Ideas meet<br /><em>experience.</em></h1><div><p>A journey through research labs, industry teams,<br />and the questions that connect them.</p><a href="#education" class="text-link">Education & visiting research <Icon /></a></div></div></section>
  <section class="container experience-section">
    <div class="section-heading journey-heading"><div><p class="eyebrow">PROFESSIONAL JOURNEY</p><h2>Research in <em>practice.</em></h2></div></div>
    <ExperienceTimeline items={experience} />
  </section>
  <section class="education-section" id="education"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / FOUNDATIONS</p><h2>Learning never <em>stops.</em></h2></div><a class="text-link" href={sitePath('cv/')}>View full CV <Icon /></a></div><div class="education-grid">{education.map((item, i) => <article class="education-card"><span class="mono">0{i + 1} / {item.period}</span><h3>{item.school}</h3><p class="role">{item.study}</p><p>{item.detail}</p></article>)}</div></div></section>
</Layout>
